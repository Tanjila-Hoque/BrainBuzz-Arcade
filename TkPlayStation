def run_odd_even():
    numbers_dataset = [12, 7, 19, 24, 33, 42, 55, 68, 79, 80, 91, 100, 113, 128, 135]

    def start():
        win = tk.Toplevel()
        win.title("Odd Even Guessing Game")
        win.resizable(False, False)
        number = random.choice(numbers_dataset)
        attempts = [0]

        tk.Label(win, text=f"Is the number {number} Odd or Even?", font=("Arial", 14)).pack(pady=10)
        result = tk.Label(win, text="", font=("Arial", 14))
        result.pack(pady=10)

        def check_guess(user_choice):
            attempts[0] += 1
            correct = (number % 2 == 0 and user_choice == "Even") or (number % 2 == 1 and user_choice == "Odd")
            if correct:
                messagebox.showinfo("Correct!", f"Yes! {number} is {user_choice}. You guessed in {attempts[0]} tries.")
                win.destroy()
            else:
                result.config(text="Wrong! Try Again.")

        btn_frame = tk.Frame(win)
        btn_frame.pack(pady=10)
        tk.Button(btn_frame, text="Odd", width=10, command=lambda: check_guess("Odd")).pack(side="left", padx=10)
        tk.Button(btn_frame, text="Even", width=10, command=lambda: check_guess("Even")).pack(side="left", padx=10)

    start()


