    letter_frequency = "etaoinshrdlucmfwypvbgkjqxz"

    def start_game():
        win = tk.Toplevel()
        win.title("Word Guessing Game")
        word = random.choice(word_dataset)
        guessed, attempts = set(), [0]
        max_attempts = 6

        def display():
            return " ".join([c if c in guessed else "_" for c in word])

        def update():
            label_word.config(text=display())
            if all(c in guessed for c in word):
                result.config(text="You won!")
