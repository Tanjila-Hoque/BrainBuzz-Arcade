        tip = tk.Label(win, text="", fg="blue")
        tip.pack()
        result = tk.Label(win, text="", font=("Arial", 14))
        result.pack()

    start_game()

# ----------------------------
# Game 2: Rock Paper Scissors
# ----------------------------
def run_rps():
    def start():
        win = tk.Toplevel()
        win.title("Rock Paper Scissors")
        history = []
        choices = ["Rock", "Paper", "Scissors"]

        def ai():
            if not history:
                return random.choice(choices)
            freq = {x: history.count(x) for x in choices}
            pred = max(freq, key=freq.get)
            counter = {"Rock": "Paper", "Paper": "Scissors", "Scissors": "Rock"}
            return counter[pred]

        def play(user):
            history.append(user)
            a = ai()
            if user == a:
                result.set("Draw")
            elif (user == "Rock" and a == "Scissors") or (user == "Scissors" and a == "Paper") or (user == "Paper" and a == "Rock"):
                result.set(f"You: {user}, AI: {a} \nYou Win!")
            else:
                result.set(f"You: {user}, AI: {a} \nAI Wins!")

        result = tk.StringVar()
        tk.Label(win, text="Choose:", font=("Arial", 14)).pack(pady=10)
        for c in choices:
            tk.Button(win, text=c, width=15, command=lambda x=c: play(x)).pack(pady=5)
        tk.Label(win, textvariable=result, font=("Arial", 14)).pack(pady=10)

    start()

# ------------------------
# Game 3: Puzzle Game (8)
# ------------------------
def run_puzzle():
    goal = [[1, 2, 3], [4, 5, 6], [7, 8, 0]]

    def start():
        win = tk.Toplevel()
        win.title("8 Puzzle Game")

        def is_solvable(board):
            flat = sum(board, [])
            inv_count = 0
            for i in range(len(flat)):
                for j in range(i + 1, len(flat)):
                    if flat[i] and flat[j] and flat[i] > flat[j]:
                        inv_count += 1
            return inv_count % 2 == 0

        def shuffle_board():
            board = sum(goal, [])
            while True:
                random.shuffle(board)
                b = [board[i*3:(i+1)*3] for i in range(3)]
                if is_solvable(b) and b != goal:
                    return b

        board = shuffle_board()
        buttons = []

        def render():
            for i in range(3):
                for j in range(3):
                    val = board[i][j]
                    buttons[i][j].config(text="" if val == 0 else str(val))

        def find0():
            for i in range(3):
                for j in range(3):
                    if board[i][j] == 0:
                        return i, j

        def click(i, j):
            x, y = find0()
            if abs(x - i) + abs(y - j) == 1:
                board[x][y], board[i][j] = board[i][j], board[x][y]
                render()
                if board == goal:
                    messagebox.showinfo("Success", "Puzzle Solved!")

        def solve():
            def h(s):
                return sum(abs((s[i][j] - 1) // 3 - i) + abs((s[i][j] - 1) % 3 - j)
                           for i in range(3) for j in range(3) if s[i][j])

            heap = [(h(board), board, [])]
            seen = set()

            while heap:
                _, state, path = heapq.heappop(heap)
                t = tuple(map(tuple, state))
                if t in seen:
                    continue
                seen.add(t)
                if state == goal:
                    path.append(state)
                    animate(path)
                    return
                x, y = [(ix, iy) for ix in range(3) for iy in range(3) if state[ix][iy] == 0][0]
                for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < 3 and 0 <= ny < 3:
                        new = copy.deepcopy(state)
                        new[x][y], new[nx][ny] = new[nx][ny], new[x][y]
                        heapq.heappush(heap, (len(path) + h(new), new, path + [state]))

        def animate(path):
            def step(i=0):
                if i < len(path):
                    for r in range(3):
                        for c in range(3):
                            board[r][c] = path[i][r][c]
                    render()
                    win.after(400, lambda: step(i + 1))
            step()

        for i in range(3):
            row = []
            for j in range(3):
                b = tk.Button(win, font=("Arial", 24), width=4, height=2, command=lambda x=i, y=j: click(x, y))
                b.grid(row=i, column=j)
                row.append(b)
            buttons.append(row)

        render()
        tk.Button(win, text="Solve AI", command=solve).grid(row=3, column=0, columnspan=3, pady=10)

    start()

