# Game 4: Snake Game (Tkinter)
# -------------------------
def run_snake():
    CELL_SIZE = 20
    WIDTH = 400
    HEIGHT = 400

    class SnakeGame(tk.Toplevel):
        def __init__(self):
            super().__init__()
            self.title("Snake Game")
            self.resizable(False, False)
            self.canvas = tk.Canvas(self, width=WIDTH, height=HEIGHT, bg="black")
            self.canvas.pack()
            self.direction = "Right"
            self.snake = [(4, 10), (3, 10), (2, 10)]
            self.food = None
            self.score = 0
            self.game_over = False
            self.after_id = None

            self.draw_score()
            self.place_food()
            self.draw_snake()
            self.bind("<Key>", self.change_dir)
            self.focus_set()
            self.game_loop()

        def draw_score(self):
            self.score_text = self.canvas.create_text(50, 10, fill="white", text=f"Score: {self.score}", anchor="nw", font=("Arial", 14))

        def place_food(self):
            while True:
                x = random.randint(0, (WIDTH // CELL_SIZE) - 1)
                y = random.randint(0, (HEIGHT // CELL_SIZE) - 1)
                if (x, y) not in self.snake:
                    self.food = (x, y)
                    break
            self.draw_food()

        def draw_food(self):
            if hasattr(self, "food_obj"):
                self.canvas.delete(self.food_obj)
            x, y = self.food
            self.food_obj = self.canvas.create_rectangle(
                x * CELL_SIZE, y * CELL_SIZE,
                (x + 1) * CELL_SIZE, (y + 1) * CELL_SIZE,
                fill="red"
            )

        def draw_snake(self):
            self.canvas.delete("snake")
            for x, y in self.snake:
                self.canvas.create_rectangle(
                    x * CELL_SIZE, y * CELL_SIZE,
                    (x + 1) * CELL_SIZE, (y + 1) * CELL_SIZE,
                    fill="green", tag="snake"
                )

        def change_dir(self, event):
            if event.keysym in ("Up", "Down", "Left", "Right"):
                opposite = {"Up":"Down", "Down":"Up", "Left":"Right", "Right":"Left"}
                if opposite[event.keysym] != self.direction:
                    self.direction = event.keysym

        def game_loop(self):
            if self.game_over:
                return
            head_x, head_y = self.snake[0]
            if self.direction == "Up":
                head_y -= 1
            elif self.direction == "Down":
                head_y += 1
            elif self.direction == "Left":
                head_x -= 1
            elif self.direction == "Right":
                head_x += 1

            if (head_x < 0 or head_x >= WIDTH // CELL_SIZE or
                head_y < 0 or head_y >= HEIGHT // CELL_SIZE or
                (head_x, head_y) in self.snake):
                self.game_over = True
                messagebox.showinfo("Game Over", f"Game Over! Your score was: {self.score}")
                self.destroy()
                return

            self.snake.insert(0, (head_x, head_y))

            if (head_x, head_y) == self.food:
                self.score += 1
                self.canvas.itemconfig(self.score_text, text=f"Score: {self.score}")
                self.place_food()
            else:
                self.snake.pop()

            self.draw_snake()
            self.after_id = self.after(150, self.game_loop)

    SnakeGame()

