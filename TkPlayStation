        "saffron", "turmeric", "cumin", "cardamom", "nutmeg", "peppermint", "chocolate",
        "honey", "sugar", "salt", "flour", "bread", "cheese", "butter", "milk",
        "egg", "coffee", "tea", "water", "juice", "wine", "beer", "soda", "cake",
        "cookie", "pie", "pasta", "rice", "soup", "salad", "steak", "chicken",
        "fish", "shrimp", "crab", "lobster", "beef", "pork", "duck", "turkey",
        "tofu", "beans", "lentils", "peas"
