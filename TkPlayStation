# Game 5: Number Guessing Game (Fixed Properly)
# -------------------------
def run_number_guess():
    def start():
        win = tk.Toplevel()
        win.title("Number Guessing Game")
        win.resizable(False, False)
        number = random.randint(1, 100)
        attempts = [0]

        tk.Label(win, text="Guess a number between 1 and 100", font=("Arial", 14)).pack(pady=10)
        entry = tk.Entry(win, font=("Arial", 14))
        entry.pack()

        result = tk.Label(win, text="", font=("Arial", 14))
        result.pack(pady=10)

        def guess():
            val_str = entry.get().strip()
            if not val_str.isdigit():  # Check valid integer
                result.config(text="Please enter a valid integer.")
                entry.delete(0, tk.END)
                return
            val = int(val_str)
            attempts[0] += 1
            if val < number:
                result.config(text="Too low!")
            elif val > number:
                result.config(text="Too high!")
            else:
                messagebox.showinfo("Congratulations!", f"You guessed it in {attempts[0]} tries!")
                win.destroy()
            entry.delete(0, tk.END)

        tk.Button(win, text="Guess", command=guess, width=15).pack(pady=5)

    start()


